# ──────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────
# Dev (default): in-process PGlite, persisted to db/dev.pglite.
# Prod: comment out the file URL and set a real PostgreSQL DSN.
DATABASE_URL=file:/home/z/my-project/db/dev.pglite
# DATABASE_URL=postgres://modavanat:CHANGE_ME_STRONG@127.0.0.1:5432/modavanat

# ──────────────────────────────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────────────────────────────
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=replace-me-in-prod
# Public origin (HTTP in dev, HTTPS in prod)
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────
# SMTP (for email magic link)
# ──────────────────────────────────────────────────────────────────────
# Local Postfix/Exim in prod, or anything (mailhog, gmail, etc.) in dev.
# When unset, magic-link URLs are logged to stdout instead of emailed.
SMTP_URL=
SMTP_FROM=noreply@modavanat.ir
