# ──────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────
# Dev (default): in-process PGlite, persisted to db/dev.pglite.
# Prod: comment out the file URL and set a real PostgreSQL DSN.
DATABASE_URL=file:/home/z/my-project/db/dev.pglite
# DATABASE_URL=postgres://modavanat:CHANGE_ME_STRONG@127.0.0.1:5432/modavanat

# ──────────────────────────────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────────────────────────────
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=replace-me-in-prod
# Public origin (HTTP in dev, HTTPS in prod)
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────
# SMTP (for email magic link)
# ──────────────────────────────────────────────────────────────────────
# Local Postfix/Exim in prod, or anything (mailhog, gmail, etc.) in dev.
# When unset, magic-link URLs are logged to stdout instead of emailed.
SMTP_URL=
SMTP_FROM=noreply@modavanat.ir

# ──────────────────────────────────────────────────────────────────────
# SMS — sms.ir (for phone OTP signup / signin / forgot-password)
# ──────────────────────────────────────────────────────────────────────
# Get an API key at https://sms.ir → Programmers → API Key list.
# Create one Sandbox key for testing (no real SMS sent, no credit deducted)
# and one Production key for live traffic. The sandbox key uses the same
# API base URL; only the key differs.
#
# When SMSIR_API_KEY is unset, OTP codes are LOGGED TO STDOUT (dev fallback)
# and the API still returns 200 so the flow can be tested end-to-end.
SMSIR_API_KEY=
SMSIR_API_BASE=https://api.sms.ir/v1
#
# Template IDs from the sms.ir panel (ارسال سریع → الگوهای عمومی/اشتراکی).
# Each template has the placeholder #CODE# in it. Different templates per
# purpose so the recipient sees the right verb (signup / signin / reset).
# The sandbox default is templateId 123456 with text "کد تایید شما: #CODE#".
SMSIR_TEMPLATE_SIGNUP=123456
SMSIR_TEMPLATE_SIGNIN=123456
SMSIR_TEMPLATE_RESET=123456
# Parameter name in the sms.ir template (case-sensitive — matches the panel).
SMSIR_PARAM_NAME=Code
